{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diary",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "diary" }],

  // Database. Replace database_id after `wrangler d1 create diary` (see README).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "diary",
      "database_id": "ee77f62a-eba0-4773-97c9-fac48ecc0404",
      "migrations_dir": "migrations"
    }
  ],


  // Entry images. Create with `wrangler r2 bucket create diary-images` before deploying.
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "diary-images" }],

  "vars": {
    // Public origin of the deployed app. Used for auth cookies/CSRF origin checks.
    "APP_URL": "http://localhost:3000",
    // Sender for sign-in codes. Use an address on a domain you have verified in Resend.
    "EMAIL_FROM": "Diary <login@example.com>"
  },

  "observability": { "enabled": true }
  // Secrets (set with `wrangler secret put`): BETTER_AUTH_SECRET, RESEND_API_KEY, DEEPSEEK_API_KEY (optional)
}
